{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build -w web",
    "outputDirectory": "web/dist",
    "rewrites": [
        {
            "source": "/((?!api/|assets/|sw\\.js|robots\\.txt|favicon|status\\.json)(?!(?:.*/)?\\.)(?!.*\\.[^/]*$).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/sw.js",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        },
        {
            "source": "/index.html",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
        },
        {
            "source": "/status.json",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.ufs.sh https://cdn.discordapp.com; font-src 'self'; connect-src 'self' wss://maincloud.spacetimedb.com https://maincloud.spacetimedb.com https://*.ufs.sh; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains"
                },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
            ]
        }
    ]
}
