{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!web/src/module_bindings/**",
            "!web/src/lib/legacy/**",
            "!docs/**",
            "!design/**",
            "!notes/**",
            "!data/**",
            "!backups/**",
            "!tmp/**",
            "!**/dist/**",
            "!**/*.md"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    }
}
