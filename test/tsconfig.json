{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "paths": {
            "@shared/*": [
                "../shared/*"
            ],
            "@bindings/*": [
                "../web/src/module_bindings/*"
            ],
            "@/src/module_bindings": [
                "../web/src/module_bindings"
            ],
            "@/src/module_bindings/*": [
                "../web/src/module_bindings/*"
            ],
            "@/*": [
                "../*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ]
}
