# Environment scheme (ACCESS-SECURITY-OPS §C.2). Key names only: never put values in this file.
# Database names are committed constants in shared/stdb-targets.ts, not env vars:
#   test = hsr-spacetimedb-test1, prod = hsr-spacetimedb-prod (host wss://maincloud.spacetimedb.com).

# ─── Target selector (not a secret) ──────────────────────────────────────────
# Node side (scripts, test harness): `--target test|prod` on every scripts/stdb/*.ts call, or
# STDB_TARGET in the shell. The flag wins; neither → the script refuses to guess.
# STDB_TARGET=

# ─── Per-target secret files (gitignored by .env*.local) ─────────────────────
# .env.test.local and .env.prod.local hold the same two keys, each for its own database.
# Both are written by `npm run stdb:bootstrap:<target>`; do not edit them by hand.
# STDB_SERVER_TOKEN=      delegate token for the server_* reducers
# STDB_SERVER_IDENTITY=   that delegate's identity (lets the next bootstrap revoke it)
# Optional, test only (tools/capture-ws-frames.ts): CAPTURE_WS_FIXTURE_TOKEN= (a guest token)

# ─── Browser (Vite) ──────────────────────────────────────────────────────────
# VITE_STDB_TARGET=test|prod. web/.env.development sets test for local dev; Vercel sets
# Preview = test and Production = prod. A build without it fails instead of picking a database.
# VITE_STDB_TARGET=

# ─── Vercel function secrets (M5) ────────────────────────────────────────────
# Set per environment in the Vercel dashboard, never in the repo or in any local file:
# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, AUTH_SECRET, STDB_SERVER_TOKEN

# Legacy keys from the Next.js app are ignored by everything (nothing reads .env.local).
